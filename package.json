{
  "name": "dsh-desktop-tauri",
  "version": "0.7.4-alpha.1",
  "description": "A Rust + Tauri 2.0 desktop shell for DeepSeek Harness.",
  "private": true,
  "type": "module",
  "author": "wang-yi-bit64",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "tauri",
    "rust",
    "desktop",
    "agent"
  ],
  "scripts": {
    "prepare:harness": "node scripts/prepare-harness.mjs",
    "prepare:primary-runtime": "node scripts/prepare-primary-runtime.mjs",
    "fetch:primary-runtime": "node scripts/fetch-primary-runtime.mjs",
    "harness:lockfile": "node scripts/prepare-harness.mjs --update-lockfile",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dev": "npm run prepare:runtime && tauri dev",
    "build": "npm run prepare:runtime && tauri build",
    "tauri": "tauri",

    "gate": "node scripts/gates.mjs",
    "verify:fast": "node scripts/gates.mjs --tier=fast",
    "verify:full": "node scripts/gates.mjs --tier=full",
    "verify:sentinels": "node scripts/gates.mjs --tier=sentinel",
    "verify:all": "npm run verify:full && npm run verify:sentinels",

    "version:show": "node scripts/version.mjs show",
    "version:set": "node scripts/version.mjs set",
    "version:bump": "node scripts/version.mjs bump",
    "version:sync-upstream": "node scripts/version.mjs sync-upstream",
    "version:verify-upstream": "node scripts/version.mjs verify-upstream",
    "changelog:notes": "node scripts/changelog.mjs --notes",
    "changelog:write": "node scripts/changelog.mjs --write",

    "check:patch-applicability": "node scripts/check-patch-applicability.mjs",
    "report:patches": "node scripts/report-patches.mjs",
    "package:cli": "node scripts/package-cli.mjs",

    "fault-inject": "node scripts/fault-inject.mjs",
    "smoke": "node scripts/smoke-launch.mjs",
    "smoke:headless": "node scripts/smoke-launch.mjs --level=1",
    "size:report": "node scripts/report-bundle-size.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "patch-package": "^8.0.1"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
