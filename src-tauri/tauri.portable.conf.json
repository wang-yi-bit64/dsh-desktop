{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "../package.json",
  "identifier": "io.dsh.desktop",
  "build": {
    "frontendDist": "./frontend",
    "beforeDevCommand": "npm run prepare:harness -- --check",
    "beforeBuildCommand": "npm run prepare:harness -- --check"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": ["zip"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bin/*",
      "resources/node/*",
      "resources/harness/**/*",
      "resources/MANIFEST.json",
      "resources/harness-node-entry.mjs",
      "resources/windows-child-process-hide.mjs",
      "resources/plugin-safety-guard.mjs",
      "resources/parent-death-watchdog.mjs",
      "resources/dsh-desktop.patch.yml",
      "resources/dsh-desktop-safe.patch.yml",
      "resources/splash.html",
      "resources/dsh-loader.gif",
      "resources/dsh-loader-dark.gif",
      "resources/plugin-recovery.html",
      "resources/windows-menu.html",
      "resources/app-icon.png"
    ],
    "createUpdaterArtifacts": false
  }
}
